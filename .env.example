# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# DIPEX â€” Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# â”€â”€ LLM Provider â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Options: huggingface | fallback (fallback = template-based, no API needed)
LLM_PROVIDER=fallback

# HuggingFace Inference API (only needed if LLM_PROVIDER=huggingface)
# Get your key at: https://huggingface.co/settings/tokens
HF_API_KEY=hf_your_token_here
HF_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.2

# â”€â”€ Kafka Streaming (OPTIONAL â€” project runs fine without it) â”€â”€
# Only needed to run: python scripts/start_kafka_pipeline.py
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=dipex-pipeline
KAFKA_TOPICS=raw_events
KAFKA_BATCH_SIZE=1000
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Kafka SASL (only needed for cloud Kafka e.g. Confluent Cloud)
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=your_api_key
# KAFKA_SASL_PASSWORD=your_api_secret

# â”€â”€ DIPEX Pipeline â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Target column for supervised ML (leave blank = unsupervised)
DIPEX_TARGET_COL=
DIPEX_DOMAIN=default
# Strict auth mode — set true in production to reject unauthenticated requests with 401
DIPEX_AUTH_STRICT=false   # change to true for production


# â”€â”€ Databases (ALL OPTIONAL â€” core pipeline uses file/DuckDB) â”€

# DuckDB (in-process by default, already works â€” no config needed)
# DUCKDB_PATH=data/dipex.duckdb

# PostgreSQL
# POSTGRES_URI=postgresql://user:password@localhost:5432/dipex

# MongoDB
# MONGO_URI=mongodb://localhost:27017/dipex

# ClickHouse (columnar)
# CH_HOST=localhost
# CH_PORT=9000
# CH_DATABASE=dipex
# CH_USER=default
# CH_PASSWORD=

# Neo4j (graph)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASS=your_password

# Elasticsearch (document/search)
# ES_HOST=http://localhost:9200
# ES_API_KEY=your_elasticsearch_api_key

# Redis (caching)
# REDIS_URL=redis://localhost:6379/0

# â”€â”€ Security â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# JWT secret for API authentication (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change_me_in_production_generate_a_strong_random_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINS=60
JWT_REFRESH_EXPIRE_HOURS=24

# â”€â”€ Monitoring â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Sentry error tracking (optional)
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# â”€â”€ Rate Limiting â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=20

# â”€â”€ CORS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
CORS_ORIGINS=http://localhost:3000

# â”€â”€ Model Registry â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
MODEL_REGISTRY_PATH=data/model_registry

# ── Encryption at rest ──────────────────────────────────────────────────────
# Fernet symmetric key — leave blank to disable encryption (development only)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DIPEX_ENCRYPTION_KEY=
# PBKDF2 salt for key derivation — change in production
DIPEX_KEY_SALT=dipex-default-salt-v1

# ── Audit ────────────────────────────────────────────────────────────────────
# Directory where per-request audit logs are written (auto-created on startup)
AUDIT_DIR=audit
